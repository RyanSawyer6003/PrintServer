# cupsd.conf template — rendered to /etc/cups/cupsd.conf by entrypoint.sh on every start.
# Placeholders:
#   @PRINT_ALLOW@     (own line) -> one "Allow from <cidr>" per entry in CUPS_PRINT_SUBNETS
#   @ADMIN_ALLOW@     (own line) -> one "Allow from <cidr>" per entry in CUPS_ADMIN_SUBNETS
#   @SERVER_NAME@     -> CUPS_SERVER_NAME (the name clients print to directly)
#   @SERVER_ALIASES@  -> CUPS_SERVER_NAME plus CUPS_SERVER_ALIASES (e.g. a reverse-proxy name)
# Site values live in .env only.

LogLevel warn

# One line per finished job, in a layout the usage reports can read reliably.
# The job name comes last because it is free text and may contain anything.
PageLogFormat %p|%u|%j|%T|%P|%C|%{job-originating-host-name}|%{sides}|%{print-color-mode}|%{job-name}

# Name CUPS puts in printer URIs it hands to clients: the direct name, never
# the proxy, so print jobs go straight to the container.
ServerName @SERVER_NAME@
# Every Host header CUPS should accept. Requests for any other name are
# rejected, so a reverse-proxy hostname must be listed here.
ServerAlias @SERVER_ALIASES@

# Listen on all interfaces inside the container. Network reachability is
# controlled by macvlan placement and the firewall; CUPS adds per-path ACLs below.
Listen *:631
Listen /run/cups/cups.sock

Browsing Off
BrowseLocalProtocols none

DefaultAuthType Basic
WebInterface Yes

<Policy default>
  # Document names, user names and source computers of other people's jobs are
  # hidden from anyone but the job's owner and admins. Without this, any client
  # on a print subnet could list them. Usage reporting is not affected: it
  # reads the page log, not the job list.
  JobPrivateAccess @OWNER @SYSTEM
  JobPrivateValues default
  SubscriptionPrivateAccess @OWNER @SYSTEM
  SubscriptionPrivateValues none

  # Submitting and validating jobs: anyone who passed the Location ACLs
  <Limit Create-Job Print-Job Print-URI Validate-Job>
    Order deny,allow
  </Limit>

  # Acting on a job or subscription: only its owner or an admin
  <Limit Send-Document Send-URI Hold-Job Release-Job Restart-Job Purge-Jobs Set-Job-Attributes Create-Job-Subscription Renew-Subscription Cancel-Subscription Get-Notifications Reprocess-Job Cancel-Current-Job Suspend-Current-Job Resume-Job Cancel-My-Jobs Close-Job CUPS-Move-Job CUPS-Get-Document>
    Require user @OWNER @SYSTEM
    Order deny,allow
  </Limit>

  <Limit Cancel-Job CUPS-Authenticate-Job>
    Require user @OWNER @SYSTEM
    Order deny,allow
  </Limit>

  # Server and printer administration: admins only, with a login
  <Limit CUPS-Add-Modify-Printer CUPS-Delete-Printer CUPS-Add-Modify-Class CUPS-Delete-Class CUPS-Set-Default CUPS-Get-Devices>
    AuthType Default
    Require user @SYSTEM
    Order deny,allow
  </Limit>

  <Limit Pause-Printer Resume-Printer Enable-Printer Disable-Printer Pause-Printer-After-Current-Job Hold-New-Jobs Release-Held-New-Jobs Deactivate-Printer Activate-Printer Restart-Printer Shutdown-Printer Startup-Printer Promote-Job Schedule-Job-After Cancel-Jobs CUPS-Accept-Jobs CUPS-Reject-Jobs>
    AuthType Default
    Require user @SYSTEM
    Order deny,allow
  </Limit>

  # Everything else (status queries such as Get-Printer-Attributes, Get-Jobs)
  <Limit All>
    Order deny,allow
  </Limit>
</Policy>

DefaultPolicy default

# --- Root: printer discovery and the public web pages ---
#     localhost is allowed so the container healthcheck can query the scheduler.
<Location />
  Order allow,deny
  Allow localhost
  @PRINT_ALLOW@
</Location>

# --- Admin: separate subnet list; login always required, and always over TLS
#     (Basic auth would otherwise send the password in clear text across sites) ---
<Location /admin>
  AuthType Default
  Require user @SYSTEM
  Encryption Required
  Order allow,deny
  @ADMIN_ALLOW@
</Location>

<Location /admin/conf>
  # cupsd.conf is read-only over HTTP. The web interface (Server Settings,
  # Edit Configuration File) and cupsctl all replace the file with a PUT to
  # /admin/conf/cupsd.conf, which would overwrite the access rules rendered
  # from .env. No account matches the name below, so every PUT is refused.
  # This block must stay first: a <Limit> copies the rules above it, and
  # "Require" adds to that copy rather than replacing it.
  <Limit PUT>
    AuthType Default
    Require user cupsd-conf-is-read-only
    Order allow,deny
  </Limit>

  AuthType Default
  Require user @SYSTEM
  Encryption Required
  Order allow,deny
  @ADMIN_ALLOW@
</Location>

<Location /admin/log>
  AuthType Default
  Require user @SYSTEM
  Encryption Required
  Order allow,deny
  @ADMIN_ALLOW@
</Location>

# --- Usage reports: static pages written by the usage service, with the job
#     log, document names and source computers. Admins, plus the view-only
#     group. That group is not the admin group, so its members can read these
#     pages and nothing else: /admin and every admin operation still need @SYSTEM. ---
<Location /usage>
  AuthType Default
  Require user @SYSTEM @usageviewers
  Encryption Required
  Order allow,deny
  @ADMIN_ALLOW@
</Location>

# --- Staff page: printer status and page totals per printer, written by the
#     usage service. No login. Open to the same subnets that can print, plus the
#     admin sources (a reverse proxy, for example). It holds no people, document
#     names, computer addresses or job log. ---
<Location /status>
  Order allow,deny
  @PRINT_ALLOW@
  @ADMIN_ALLOW@
</Location>

# --- Job submission from client subnets (staff and student) ---
<Location /printers>
  Order allow,deny
  @PRINT_ALLOW@
</Location>

<Location /classes>
  Order allow,deny
  @PRINT_ALLOW@
</Location>

# --- Job listing: owner or admin can see full details, masked for anyone else ---
<Location /jobs>
  AuthType Default
  Require user @OWNER @SYSTEM
  Order allow,deny
  @PRINT_ALLOW@
</Location>

DefaultEncryption IfRequested
