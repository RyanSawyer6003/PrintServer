# Copy to .env and fill in real values on the server. .env is gitignored — never commit it.
# The values below are placeholders.

# --- CUPS admin account (created on first container start, member of lpadmin) ---
CUPS_ADMIN_USER=printadmin
# Leave blank to have a random password generated and printed once in `docker logs`
CUPS_ADMIN_PASSWORD=

# --- Container identity ---
CUPS_HOSTNAME=cups
CUPS_CONTAINER_NAME=cups

# --- Client/admin-facing network (macvlan) ---
SERVICES_PARENT_IF=eth0
SERVICES_SUBNET=10.10.10.0/24
SERVICES_GATEWAY=10.10.10.1
SERVICES_IP=10.10.10.50

# --- Printer network (macvlan) ---
PRINTER_PARENT_IF=eth1
PRINTER_SUBNET=10.20.20.0/24
PRINTER_GATEWAY=10.20.20.1
PRINTER_IP=10.20.20.10

# --- Who can reach CUPS (rendered into cupsd.conf at every start) ---
# Space- or comma-separated IPv4 CIDRs.
# PRINT: every client subnet that submits jobs (staff and student, all sites).
CUPS_PRINT_SUBNETS="10.30.0.0/16 10.40.0.0/22"
# ADMIN: subnets allowed to open /admin. Login is always required, and TLS is
# enforced on /admin, so this can match the staff subnets if IT shares them.
CUPS_ADMIN_SUBNETS="10.30.0.0/16"
