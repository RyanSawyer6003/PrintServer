# Copy to .env and fill in real values on the server. .env is gitignored — never commit it.
# The values below are placeholders.

# --- CUPS admin account (created on first container start, member of lpadmin) ---
CUPS_ADMIN_USER=printadmin
# Leave blank to have a random password generated and printed once in `docker logs`
CUPS_ADMIN_PASSWORD=

# --- Container identity ---
CUPS_CONTAINER_NAME=cups
# The container's own hostname. CUPS issues its self-signed certificate to this
# name, so it must be the full name clients print to. It defaults to
# CUPS_SERVER_NAME; leave it unset unless the two have to differ. Changing it
# makes CUPS issue a new certificate, which clients then have to trust again.
#CUPS_HOSTNAME=direct.example.org

# --- Client/admin-facing network (macvlan) ---
SERVICES_PARENT_IF=eth0
SERVICES_SUBNET=10.10.10.0/24
SERVICES_GATEWAY=10.10.10.1
SERVICES_IP=10.10.10.50

# --- Printer network (macvlan) ---
PRINTER_PARENT_IF=eth1
PRINTER_SUBNET=10.20.20.0/24
PRINTER_GATEWAY=10.20.20.1
PRINTER_IP=10.20.20.10

# --- Names CUPS answers to ---
# SERVER_NAME: the full name clients print to directly. CUPS puts it in the
# printer URIs it hands out, so jobs bypass any reverse proxy.
CUPS_SERVER_NAME=direct.example.org
# SERVER_ALIASES: other Host headers to accept, e.g. a reverse-proxy name used
# for the admin UI. CUPS rejects requests for names not listed.
CUPS_SERVER_ALIASES=print.example.org

# --- Who can reach CUPS (rendered into cupsd.conf at every start) ---
# Space- or comma-separated IPv4 CIDRs.
# PRINT: every client subnet that submits jobs. These subnets can also open the
# staff page at /status/ without a login.
CUPS_PRINT_SUBNETS="10.30.0.0/16 10.40.0.0/22"
# ADMIN: subnets allowed to open /admin and /usage/. Login is always required and TLS is enforced.
# Behind a reverse proxy, set this to the proxy's address only (e.g. 10.30.5.20/32)
# so /admin can't be reached directly on the container.
CUPS_ADMIN_SUBNETS="10.30.0.0/16"

# --- Staff page (served at /status/ to the print subnets, no login) ---
# How often the server tests whether each printer answers on its print port.
# A printer shows as down after two failed checks in a row.
STATUS_CHECK_MINUTES=5

# --- View-only login for the usage reports (optional) ---
# An account that can sign in to /usage/ and nothing else: it can't open /admin
# or change queues or jobs. Set both to create it; leave both blank for none.
# The password is applied on every start.
USAGE_VIEWER_USER=
USAGE_VIEWER_PASSWORD=

# --- Usage reports (served at /usage/ with a login) ---
# Pages each person may print per month. Report only: nobody is ever blocked;
# people over this number are flagged on the report. 0 means no allowance.
USAGE_MONTHLY_PAGES=500
# Time zone for month boundaries and the times shown on the report (IANA name).
USAGE_TIMEZONE=America/New_York
# Only if the container warns at startup that the reports and staff page are
# mounted in the wrong place; it prints the value to use.
#CUPS_DOCROOT=/usr/share/cups/doc-root

# --- Backups (scripts/backup.sh; see docs/backup.md) ---
# Where the encrypted snapshots go: an absolute path on the Docker host (a
# mounted external drive or network share), or a restic remote such as s3:...
# Leave both blank until backups are set up.
RESTIC_REPOSITORY=
# Encrypts the snapshots. Keep a copy somewhere other than this server: this
# file is inside the backup, so without the password the backup can't be opened.
RESTIC_PASSWORD=
# How many nightly snapshots to keep (defaults shown).
#BACKUP_KEEP_DAILY=14
#BACKUP_KEEP_WEEKLY=8
#BACKUP_KEEP_MONTHLY=12
